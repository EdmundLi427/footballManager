# Azure Functions Environment Variables
# Copy this to .env (or local.settings.json for local development)
# and fill in your actual values.

# ===== Existing: FantasyPros Injury News =====

# FantasyPros API key for injury news endpoint
FANTASY_PRO_API_KEY=your_fantasy_pros_api_key_here

# Azure Storage connection string (shared across all data ingestion)
# If not provided, defaults to AzureWebJobsStorage (the Functions host's own storage)
NEWS_STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...

# Azure Blob Storage container for all NFL data (news + ESPN datasets)
# Renamed from NEWS_CONTAINER for clarity (holds more than just news now)
ALSOURCE_CONTAINER=alsource

# ===== New: ESPN Game/Team/Player Data =====

# Concurrency limit for ESPN API calls (team rosters, game summaries, etc.)
# Default: 5 (bounded to be respectful of undocumented ESPN API)
ESPN_FETCH_CONCURRENCY=5

# Number of retries per ESPN API call
# Default: 3
ESPN_FETCH_RETRIES=3

# Days to look back for completed games to re-fetch (catches stat corrections)
# Default: 3
GAME_SUMMARY_TRAILING_DAYS=3

# Safety ceiling on game-summary fetches per run
# Default: 50 (prevents runaway requests if filtering logic fails)
GAME_SUMMARY_MAX_TARGETS=50

# ===== Development =====

# For local development with Azure Storage Emulator (Azurite)
# Uncomment to use local emulator instead of real storage account
# NEWS_STORAGE_CONNECTION=UseDevelopmentStorage=true
